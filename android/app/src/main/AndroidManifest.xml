<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for every API call this app makes (login, attendance, tasks, etc.) — without this,
         Android blocks all network access and every request fails with a generic SocketException, which
         surfaces to the user as "Something went wrong" rather than a real error message. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by the geolocator package (punch in/out geofencing, field-visit trip tracking) — without
         these, permission_handler/geolocator's runtime permission request silently fails since Android
         only allows requesting a permission that's actually declared here. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Lets trip tracking (TripTrackingService) keep getting location updates while the app is
         backgrounded or fully closed — Android 10+ (API 29) requires this as a *separate* grant from
         ACCESS_FINE_LOCATION, requested at runtime only after the foreground grant, same two-step flow
         every background-location app needs. Without it, the background service's Geolocator stream
         simply stops producing updates once the app leaves the foreground, silently. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required for flutter_background_service's Android foreground service (trip tracking) to run at
         all on API 28+, and specifically as a "location" type service on API 34+ (Android 14) — without
         the typed permission, starting a location-type foreground service throws SecurityException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required on Android 13+ (API 33) to show any notification at all — without this,
         firebase_messaging's runtime permission request silently fails the same way geolocator's would
         without ACCESS_FINE_LOCATION above. Also covers the persistent "Trip in progress" notification
         flutter_background_service's foreground mode requires while a trip is active. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the background trip-tracking service avoid being paused by the CPU sleeping between GPS
         fixes — flutter_background_service's own Android implementation requests this internally, but it
         still needs to be declared here to actually be granted. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="JMM InfoTech"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- google_maps_flutter reads this at runtime. Value comes from android/local.properties
             (gitignored) via the manifestPlaceholders["mapsApiKey"] wired in app/build.gradle.kts —
             never hardcode the key here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <!-- Default channel FCM/flutter_local_notifications posts to when a message doesn't specify one
             (background/terminated messages from PushNotificationService.cs never set an Android-specific
             channel) — must match the channel id created in push_notification_service.dart's
             flutter_local_notifications setup. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jmm_default_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_background_service's own foreground service (TripTrackingService) — explicit
             foregroundServiceType="location" is required on Android 14+ (API 34) for any foreground
             service that reports location, matching the FOREGROUND_SERVICE_LOCATION permission above. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
