<?xml version="1.0" encoding="utf-8"?>
<!-- Release/production config: HTTPS only. The live backend (https://portal.jmmportal.com) needs no
     exception. The dev/LAN cleartext exceptions (local IIS Express over HTTP) live in
     src/debug/res/xml/network_security_config.xml, which Android merges in for debug builds only — so a
     Play Store build can never talk plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
